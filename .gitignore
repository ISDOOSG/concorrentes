# host:porta:banco:usuario:senha nao bate com nenhum padrao dela. .env.db
# ela pegaria (linha *_SENHA=), mas o .gitignore e a primeira camada, nao a
# unica. NUNCA remover estas duas linhas.
.pgpass
.env.db

